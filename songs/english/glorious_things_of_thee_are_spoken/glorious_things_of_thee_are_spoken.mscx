      <Staff id="1">
        <VBox>
          <height>13.4</height>
          <Text>
            <style>Title</style>
            <offset x="0" y="-0.0367454" />
            <text>
              <font size="22" />
              <font face="Felix Titling" />Glorious Things of Thee Are Spoken</text>
          </Text>
          <Text>
            <style>Subtitle</style>
