        <linkedMain/>
        <Text>
          <linkedMain/>
          <style>Title</style>
          <offset x="0.690599" y="-6.90599"/>
          <text>Wat zal de wereld mooi zijn op die dag</text>
          </Text>
        <Text>
          <linkedMain/>
          <style>Subtitle</style>
          <size>9</size>
          <offset x="2.99272" y="2.1876"/>
          <text>&quot;(...) de tabernakel Gods is bij de mensen, en Hij zal bij hen wonen, en zij zullen Zijn volk zijn (...)&quot; Openbaringen 21:3</text>
          </Text>
        <Text>
          <linkedMain/>
          <style>Composer</style>
          <text>T. Pebesma</text>
          </Text>
