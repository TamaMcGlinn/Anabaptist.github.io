        <linkedMain/>
        <Text>
          <linkedMain/>
          <style>Title</style>
          <text>Na drzewie krzyża wisiał ktoś</text>
          </Text>
        <Text>
          <linkedMain/>
          <style>Subtitle</style>
          <size>9</size>
          <text>&quot;Gdyż i Chrystus raz za grzechy cierpiał, sprawiedliwy za niesprawiedliwych, aby nas przyprowadzić do Boga.&quot; 1 Piotr 3:18</text>
          </Text>
        <Text>
          <linkedMain/>
          <style>Lyricist</style>
          <text>John Newton 1725-1807</text>
          </Text>
