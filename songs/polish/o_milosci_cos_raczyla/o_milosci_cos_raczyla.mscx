        <linkedMain/>
        <Text>
          <linkedMain/>
          <style>Title</style>
          <text>O Miłości, coś raczyła</text>
          </Text>
        <Text>
          <linkedMain/>
          <style>Subtitle</style>
          <size>9</size>
          <text>&quot;Gdy upodobało się Bogu, który mnie ..... powołał swoją łaską; Aby objawić swego Syna we mnie.&quot; Gal. 1:15,16 </text>
          </Text>
        <Text>
          <linkedMain/>
          <style>Lyricist</style>
          <text>Johann Scheffler 1624-1677</text>
          </Text>
